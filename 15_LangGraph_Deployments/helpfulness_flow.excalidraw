      "frameId": null,
      "roundness": null,
      "seed": 1010,
      "version": 1,
      "versionNonce": 2010,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "helpfulness_node\n-------------------------------\nCHECK: len(messages) > 10?\n  YES → return \"HELPFULNESS:END\"\n        (skip LLM evaluation)\n\nNO → continue evaluation:\n  initial_query = messages[0]\n  final_response = messages[-1]\n\n  get_chat_model(\"gpt-4.1-mini\")\n    .with_structured_output(\n         HelpfulnessResult)\n  → HelpfulnessResult(is_helpful)\n\n  return \"HELPFULNESS:Y\" (helpful)\n      OR \"HELPFULNESS:N\" (not)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "help_el",
      "originalText": "helpfulness_node\n-------------------------------\nCHECK: len(messages) > 10?\n  YES → return \"HELPFULNESS:END\"\n        (skip LLM evaluation)\n\nNO → continue evaluation:\n  initial_query = messages[0]\n  final_response = messages[-1]\n\n  get_chat_model(\"gpt-4.1-mini\")\n    .with_structured_output(\n         HelpfulnessResult)\n  → HelpfulnessResult(is_helpful)\n\n  return \"HELPFULNESS:Y\" (helpful)\n      OR \"HELPFULNESS:N\" (not)",
      "lineHeight": 1.25,
      "autoResize": true
    },
